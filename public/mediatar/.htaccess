# A mediatar csak kepet/fajlt szolgal ki: itt semmilyen szkript nem futhat.
# (Mappalistazas a public/.htaccess miatt amugy sincs.)
<FilesMatch "(?i)\.(php\d?|phtml|phar|pl|py|cgi|sh|shtml|htaccess|htpasswd)$">
    Require all denied
</FilesMatch>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
